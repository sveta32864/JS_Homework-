{
	"info": {
		"_postman_id": "5c9e4d64-a9b6-438f-b068-248e07720b92",
		"name": "Book ISBN Number Pivovarova ДЗ 18.1",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
